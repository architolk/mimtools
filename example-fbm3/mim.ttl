PREFIX fbm:  <http://bp4mc2.org/def/fbm#>
PREFIX mim:  <http://modellen.mim-standaard.nl/def/mim#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

<urn:facttype:routenaam>
        a               mim:PrimitiefDatatype;
        rdfs:label      "routenaam";
        mim:identifier  "Troutenaam" .

<urn:facttype:plaatsnaam>
        a               mim:PrimitiefDatatype;
        rdfs:label      "plaatsnaam";
        mim:identifier  "Tplaatsnaam" .

<urn:facttype:routeheeftroutenaam>
        a                  mim:Attribuutsoort;
        rdfs:label         "routenaam";
        mim:identifier     "Trouteheeftroutenaam";
        mim:kardinaliteit  "1..1";
        mim:toelichting    "[route] heeft [routenaam]";
        mim:type           <urn:facttype:routenaam> .

<urn:role:plaatsnaam>
        a                   mim:Attribuutsoort;
        rdfs:label          "plaatsnaam";
        mim:identificerend  true;
        mim:identifier      "Tplaatsnaam";
        mim:kardinaliteit   "1..1";
        mim:type            <urn:facttype:plaatsnaam> .

<urn:facttype:plaats>
        a               mim:Objecttype;
        rdfs:label      "Plaats";
        mim:attribuut   <urn:role:plaatsnaam>;
        mim:identifier  "Tplaats" .

<urn:facttype:route>  a      mim:Relatieklasse;
        rdfs:label           "Route";
        mim:attribuut        <urn:facttype:routeheeftroutenaam>;
        mim:bron             <urn:facttype:plaats>;
        mim:doel             <urn:facttype:plaats>;
        mim:identifier       "Troute";
        mim:relatierol       [ a                  mim:RelatierolDoel;
                               rdfs:label         "aankomst";
                               mim:doel           <urn:facttype:plaats>;
                               mim:kardinaliteit  "0..*"
                             ];
        mim:relatierol       [ a                  mim:RelatierolBron;
                               rdfs:label         "vertrek";
                               mim:bron           <urn:facttype:plaats>;
                               mim:kardinaliteit  "0..*"
                             ];
        mim:toelichting      "route gaat van [vertrekplaats] naar [aankomstplaats]";
        mim:unidirectioneel  false .
