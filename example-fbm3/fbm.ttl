@prefix fbm: <http://bp4mc2.org/def/fbm#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.

<urn:facttype:plaats> a fbm:Objecttype;
  rdfs:label "Plaats";
  fbm:role <urn:role:plaatsnaam>
.
<urn:role:plaatsnaam> a fbm:Role;
  fbm:playedBy <urn:facttype:plaatsnaam>;
.

<urn:facttype:plaatsnaam> a fbm:Valuetype;
  rdfs:label "plaatsnaam";
.

<urn:facttype:route> a fbm:Objecttype;
  rdfs:label "Route";
  fbm:role <urn:role:vertrekplaats>;
  fbm:role <urn:role:aankomstplaats>;
  fbm:constraint [
    a fbm:UniquenessConstraint;
    fbm:restricts <urn:role:vertrekplaats>;
    fbm:restricts <urn:role:aankomstplaats>
  ];
  fbm:predicate [
    fbm:ordersRole [fbm:role <urn:role:vertrekplaats>; fbm:atPosition 1];
    fbm:ordersRole [fbm:role <urn:role:aankomstplaats>; fbm:atPosition 2];
    fbm:reading [
      fbm:text "route gaat van [vertrekplaats] naar [aankomstplaats]";
      fbm:parts ("route gaat van" <urn:role:vertrekplaats> "naar" <urn:role:aankomstplaats>);
    ];
  ];
.
<urn:role:vertrekplaats> a fbm:Role;
  rdfs:label "vertrek";
  fbm:playedBy <urn:facttype:plaats>;
.
<urn:role:aankomstplaats> a fbm:Role;
  rdfs:label "aankomst";
  fbm:playedBy <urn:facttype:plaats>;
.

<urn:facttype:routeheeftroutenaam> a fbm:Facttype;
  rdfs:label "routenaam";
  fbm:role <urn:role:route>;
  fbm:role <urn:role:routenaam>;
  fbm:constraint [
    a fbm:UniquenessConstraint;
    fbm:restricts <urn:role:route>;
  ];
  fbm:constraint [
    a fbm:MandatoryConstraint;
    fbm:restricts <urn:role:route>;
  ];
  fbm:predicate [
    fbm:ordersRole [fbm:role <urn:role:route>; fbm:atPosition 1];
    fbm:ordersRole [fbm:role <urn:role:routenaam>; fbm:atPosition 2];
    fbm:reading [
      fbm:text "[route] heeft [routenaam]";
      fbm:parts (<urn:role:route> "heeft" <urn:role:routenaam>);
    ];
  ];
.
<urn:role:route> a fbm:Role;
  fbm:playedBy <urn:facttype:route>;
.
<urn:role:routenaam> a fbm:Role;
  fbm:playedBy <urn:facttype:routenaam>
.
<urn:facttype:routenaam> a fbm:Valuetype;
  rdfs:label "routenaam";
.
