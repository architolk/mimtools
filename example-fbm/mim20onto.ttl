                          sh:class     mim:Rolinvulling;
                          sh:maxCount  1;
                          sh:minCount  1;
                          sh:path      mim:bron
                        ];
        sh:property     [ rdf:type     sh:PropertyShape;
                          rdfs:label   "doel";
                          sh:class     mim:Rolinvulling;
                          sh:maxCount  1;
                          sh:minCount  1;
                          sh:path      mim:doel
                        ];
        sh:targetClass  mim:Verwoording .

mim:Attribuuttype  rdf:type  sh:NodeShape , rdfs:Class;
        rdfs:label      "Attribuuttype";
        sh:property     [ rdf:type     sh:PropertyShape;
                          rdfs:label   "waardetype";
                          sh:maxCount  1;
                          sh:minCount  1;
                          sh:path      mim:waardetype
                        ];
        sh:property     [ rdf:type     sh:PropertyShape;
                          rdfs:label   "type";
                          sh:maxCount  1;
