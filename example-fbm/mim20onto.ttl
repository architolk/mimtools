        sh:property     [ rdf:type     sh:PropertyShape;
                          rdfs:label   "type";
                          sh:maxCount  1;
                          sh:minCount  1;
                          sh:path      rdf:type
                        ];
        sh:property     [ rdf:type     sh:PropertyShape;
                          rdfs:label   "rolinvuller";
                          sh:maxCount  1;
                          sh:minCount  1;
                          sh:node      [ sh:xone  ( mim:Objecttype mim:Relatieobjecttype )
                                       ];
                          sh:path      mim:rolinvuller
                        ];
        sh:property     [ rdf:type     sh:PropertyShape;
                          rdfs:label   "kardinaliteit";
                          sh:datatype  xsd:string;
                          sh:maxCount  1;
                          sh:minCount  1;
                          sh:nodeKind  sh:Literal;
                          sh:path      mim:kardinaliteit
                        ];
        sh:targetClass  mim:Rolinvulling .

mim:Verwoording  rdf:type  sh:NodeShape , rdfs:Class;
        rdfs:label      "Verwoording";
        sh:property     [ rdf:type     sh:PropertyShape;
